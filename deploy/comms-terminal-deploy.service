[Unit]
Description=Comms Terminal GitHub webhook receiver
After=network.target

[Service]
Type=simple
User=inbox-deploy
Group=inbox-deploy
ExecStart=/usr/bin/python3 /opt/comms-terminal-deploy/github_deploy.py serve --config /etc/comms-terminal-deploy/config.json
LoadCredentialEncrypted=github-webhook-secret:/etc/credstore.encrypted/comms-terminal-deploy.github-webhook-secret
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/comms-terminal-deploy/queue
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
