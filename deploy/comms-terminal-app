#!/bin/sh
# The Comms Terminal desktop App on Linux and macOS (ADR 0013). Installed as ~/.local/bin/comms-terminal-app-launch;
# the desktop entry (Linux) or ~/Applications/Comms Terminal App.app (macOS) runs it. Like deploy/comms-terminal-local
# it installs the build the Service runs: the Local core (Python, with uv) and the App (Rust, with cargo) from an
# export of that commit in the local checkout (COMMS_TERMINAL_REPO). The core works on its own copy of the inbox in
# $DATA and outlives the window; an update stops it so the new one starts. The App quits with 75 when the Service reports a new build: update, open again.
#   comms-terminal-app-launch            update if needed, then open the App
#   comms-terminal-app-launch --install  install main's desktop entry and launcher, then update
#   comms-terminal-app-launch --prepare  install the Service's build and return (the App runs it while it stays open)
# --install keeps COMMS_TERMINAL_REPO and COMMS_TERMINAL_SSH (the ssh arguments that reach your Service; Jeremy's
# Oracle when unset) in $DATA/env, so the desktop entry, which starts without them, finds the same ones.
set -eu

DATA="${XDG_DATA_HOME:-$HOME/.local/share}/comms-terminal-app"
mkdir -p "$DATA/bin"
chmod 700 "$DATA"
if [ "${1:-}" = "--install" ]; then
    for name in COMMS_TERMINAL_REPO COMMS_TERMINAL_SSH; do
        eval "value=\${$name:-}"
        case "$value" in *"'"*) echo "$name must not contain a single quote" >&2; exit 2 ;; esac
        if [ -n "$value" ]; then printf "%s='%s'\n" "$name" "$value"; fi
    done > "$DATA/env"
fi
[ -f "$DATA/env" ] && . "$DATA/env"
SSH_ARGS="${COMMS_TERMINAL_SSH:-"-i $HOME/.ssh/oracle-dev -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes \
-o UpdateHostKeys=no -o HostKeyAlias=universal-inbox-existing-arm -o BatchMode=yes -o ConnectTimeout=10 \
-o LogLevel=ERROR ubuntu@168.138.69.153"}"
REPO="${COMMS_TERMINAL_REPO:-$HOME/Workspace/comms-terminal}"
[ -n "${COMMS_TERMINAL_SSH:-}" ] || export COMMS_TERMINAL_SERVICE_NAME="${COMMS_TERMINAL_SERVICE_NAME:-Oracle}"
# A desktop entry or a macOS app starts with a bare PATH: find uv and cargo where their installers put them.
PATH="$HOME/.local/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export UV_TOOL_DIR="$DATA/tools" UV_TOOL_BIN_DIR="$DATA/bin" CARGO_TARGET_DIR="$DATA/target"

place() {  # place FILE MODE DEST: main's copy of deploy/FILE, whatever the checkout has checked out
    mkdir -p "$(dirname "$3")"
    git -C "$REPO" show "origin/main:deploy/$1" > "$3.new"
    chmod "$2" "$3.new"
    mv "$3.new" "$3"
}

if [ "${1:-}" = "--install" ]; then
    git -C "$REPO" fetch -q origin
    place comms-terminal-app 755 "$HOME/.local/bin/comms-terminal-app-launch"
    if [ "$(uname)" = Darwin ]; then
        app="$HOME/Applications/Comms Terminal App.app/Contents"
        place comms-terminal-app.plist 644 "$app/Info.plist"
        mkdir -p "$app/MacOS"
        printf '#!/bin/sh\nexec "$HOME/.local/bin/comms-terminal-app-launch"\n' > "$app/MacOS/comms-terminal-app-launch"
        chmod 755 "$app/MacOS/comms-terminal-app-launch"
    else
        place comms-terminal-app.desktop 644 "${XDG_DATA_HOME:-$HOME/.local/share}/applications/comms-terminal-app.desktop"
    fi
fi

installed() {  # the build this install came from (written below), or nothing
    cat "$DATA/installed-build" 2>/dev/null || true
}

stop_core() {  # the old core keeps the old code; the App starts the new one
    pkill -f -- "--db $DATA/inbox.db" 2>/dev/null || true
}

update() {
    want=$(cat "$DATA/service-build" 2>/dev/null || true)
    have=$(installed)
    [ -n "$have" ] && { [ -z "$want" ] || [ "$want" = "$have" ]; } && return 0
    echo "Comms Terminal App: installing the Service's version ${want:-(latest main)}…"
    git -C "$REPO" fetch -q origin
    rev=$(git -C "$REPO" rev-parse --verify -q "${want:-origin/main}^{commit}")
    short=${want:-$(git -C "$REPO" rev-parse --short "$rev")}
    src="$DATA/src"
    rm -rf "$src"
    mkdir -p "$src"
    git -C "$REPO" archive "$rev" | tar -x -C "$src"
    COMMS_TERMINAL_BUILD="$(git -C "$REPO" log -1 --format=%ct "$rev") $short" \
        uv tool install -q --reinstall --python 3.12 "$src"
    cargo build -q --release --manifest-path "$src/app/Cargo.toml"
    install -m 755 "$CARGO_TARGET_DIR/release/comms-terminal-app" "$DATA/bin/comms-terminal-app"
    # The installed launcher follows the build too: the running one keeps its old copy, the next start reads the new.
    if [ -f "$INSTALLED" ]; then
        git -C "$REPO" show "$rev:deploy/comms-terminal-app" > "$INSTALLED.new" && chmod 755 "$INSTALLED.new" && mv "$INSTALLED.new" "$INSTALLED"
    fi
    stop_core
    echo "$short" > "$DATA/installed-build"
}

LAUNCHER="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")" INSTALLED="$HOME/.local/bin/comms-terminal-app-launch"
if [ "${1:-}" = "--prepare" ]; then
    update
    exit 0
fi
# One launcher at a time: a second start (the window seemed gone while an update built) leaves the first one be.
if [ -f "$DATA/launch.pid" ] && kill -0 "$(cat "$DATA/launch.pid")" 2>/dev/null; then
    echo "Comms Terminal App is already open or updating." >&2
    exit 0
fi
echo $$ > "$DATA/launch.pid"

export COMMS_TERMINAL_CORE="[\"$DATA/bin/comms-terminal\", \"--db\", \"$DATA/inbox.db\", \"--remote\", \"$SSH_ARGS\"]"
export COMMS_TERMINAL_APP_PREPARE="$LAUNCHER"
while :; do
    # In its own process, so a failed build stops only the update: the installed build still opens.
    "$LAUNCHER" --prepare || [ -x "$DATA/bin/comms-terminal-app" ] || exit 1
    rc=0
    "$DATA/bin/comms-terminal-app" || rc=$?
    [ "$rc" -eq 75 ] && continue
    exit "$rc"
done
