[Unit]
Description=Apply accepted Universal Inbox GitHub notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/universal-inbox-deploy/github_deploy.py update --config /etc/universal-inbox-deploy/config.json
TimeoutStartSec=infinity
UMask=0077
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/universal-inbox-deploy -/home/jerry/.local/opt -/home/jerry/.local/share/universal-inbox -/home/jerry/.cache/uv -/var/lib/universal-inbox/home
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
