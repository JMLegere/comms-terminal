# Universal Inbox service: public hooks (/hooks/email, /hooks/slack), the console's reply socket, and wake().
# Install and credentials: docs/runbook.md. Root-managed system unit that runs as jerry (docs/prd.md §4).

[Unit]
Description=Universal Inbox (hooks, reply socket, wake)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jerry
Group=jerry
Environment=UNIVERSAL_INBOX_DB=/home/jerry/.local/share/universal-inbox/inbox.db
ExecStart=/home/jerry/.local/bin/universal-inbox --socket /run/universal-inbox/inbox.sock serve --host 127.0.0.1 --port 8787 --files-host 192.168.0.107
Restart=on-failure
RestartSec=5

# The reply socket lives here; the service creates it 0600 for jerry (NFR-4).
RuntimeDirectory=universal-inbox
RuntimeDirectoryMode=0700

# Secrets, decrypted by systemd into $CREDENTIALS_DIRECTORY; never in the environment or on disk in clear (NFR-5).
# Slack's two secrets are added by the drop-in deploy/universal-inbox.service.d/slack.conf once Slack is
# connected; until then /hooks/slack answers 503 and Slack replies are refused.
LoadCredentialEncrypted=email-hook-secret:/etc/credstore.encrypted/universal-inbox.email-hook-secret
LoadCredentialEncrypted=resend-api-key:/etc/credstore.encrypted/universal-inbox.resend-api-key

# Hardening: read-only system and home, except the database directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/jerry/.local/share/universal-inbox
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
