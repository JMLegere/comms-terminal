[Unit]
Description=Cloudflare tunnel for Universal Inbox deployment webhooks
Wants=network-online.target
After=network-online.target universal-inbox-deploy.service

[Service]
User=inbox-deploy
Group=inbox-deploy
LoadCredentialEncrypted=tunnel-credentials:/etc/credstore.encrypted/universal-inbox-deploy.tunnel-credentials
ExecStart=/opt/universal-inbox-deploy/cloudflared --no-autoupdate --config /etc/universal-inbox-deploy/cloudflared.yml tunnel --protocol http2 run --credentials-file ${CREDENTIALS_DIRECTORY}/tunnel-credentials
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
