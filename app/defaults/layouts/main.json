{
  "id": "root",
  "type": "row",
  "background": "canvas",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 248 },
      "background": "chrome",
      "border": { "side": "right", "color": "border" },
      "children": [
        { "id": "brand", "type": "block", "size": { "px": 46 }, "view": "brand" },
        { "id": "rail", "type": "block", "view": "nav" }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        { "id": "topbar", "type": "block", "size": { "px": 42 }, "view": "topbar" },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            { "id": "list", "type": "block", "size": { "px": 460 }, "view": "threads", "card": true },
            { "id": "detail", "type": "block", "view": "thread", "card": true }
          ]
        },
        { "id": "statusbar", "type": "block", "size": { "px": 28 }, "view": "status" }
      ]
    }
  ]
}
